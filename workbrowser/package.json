{
  "name": "workbrowser",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.7",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "server": "tsx server/index.ts",
    "typecheck": "wxt prepare && vue-tsc --noEmit",
    "test": "vitest run",
    "check": "corepack pnpm typecheck && corepack pnpm test && corepack pnpm build",
    "postinstall": "wxt prepare",
    "test:browser": "tsx scripts/browser-smoke.ts",
    "test:agent-browser": "tsx scripts/agent-browser-smoke.ts",
    "test:conversation-vision": "tsx scripts/conversation-vision-smoke.ts",
    "test:permissions": "tsx scripts/permissions-smoke.ts",
    "test:activity": "tsx scripts/activity-smoke.ts",
    "ai:check": "tsx scripts/check-connection.ts"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "@tailwindcss/oxide"
    ]
  },
  "dependencies": {
    "@hono/node-server": "2.1.8",
    "hono": "4.13.18",
    "jose": "6.2.17",
    "puppeteer-core": "25.16.0",
    "vue": "3.5.45",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.5",
    "@types/chrome": "0.3.7",
    "@types/node": "22.20.5",
    "@wxt-dev/module-vue": "1.0.3",
    "tailwindcss": "4.3.5",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.1.0",
    "vue-tsc": "3.3.14",
    "wxt": "0.21.5"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
