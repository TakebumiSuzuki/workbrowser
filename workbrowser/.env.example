# Copy this file to .env ON THE COMPANY SERVER COMPUTER. Never put credentials in the extension.
# No model is called until a provider and a model are explicitly configured.
AI_PROVIDER=vertex
# Set an actual function-calling Gemini model ID available in your company project/region.
AI_MODEL=
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
# Local use: install Google Cloud CLI, then gcloud auth application-default login.
VERTEX_AUTH=gcloud

# Optional alternative, only if your company approves the Gemini Developer API:
# AI_PROVIDER=gemini
# GEMINI_API_KEY=
# AI_MODEL=

PORT=8787
# 127.0.0.1 for a server on the same PC. Containers with direct port publishing may need 0.0.0.0.
HOST=127.0.0.1
LOCAL_EMAIL=developer@example.test
# Local role only; this is not Workspace authentication.
LOCAL_ROLE=admin
